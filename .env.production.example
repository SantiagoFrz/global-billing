# Core
APP_VERSION=0.1.0
DEBUG=false
DJANGO_SECRET_KEY=replace-with-at-least-50-random-characters
FIELD_ENCRYPTION_KEY=replace-with-a-fernet-key
ALLOWED_HOSTS=billing.globalautomate.co,backend
CSRF_TRUSTED_ORIGINS=https://billing.globalautomate.co
CORS_ALLOWED_ORIGINS=https://billing.globalautomate.co
SECURE_SSL_REDIRECT=true

# PostgreSQL
POSTGRES_DB=global_billing
POSTGRES_USER=global_billing
POSTGRES_PASSWORD=replace-with-a-long-random-password
POSTGRES_HOST=postgres
POSTGRES_PORT=5432

# Redis / Celery
CELERY_BROKER_URL=redis://redis:6379/0
CELERY_RESULT_BACKEND=redis://redis:6379/1

# Frontend
BACKEND_INTERNAL_URL=http://backend:8000

# Initial admin (used once by bootstrap_admin)
INITIAL_ADMIN_EMAIL=
INITIAL_ADMIN_NAME=
INITIAL_ADMIN_PASSWORD=

# Optional compatible remote backup storage
BACKUP_S3_URI=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=
